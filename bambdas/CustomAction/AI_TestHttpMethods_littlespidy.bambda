id: f0bf1459-d92f-4a38-936c-9d5942a5c529
name: Test HTTP Methods
function: CUSTOM_ACTION
location: PROXY_HTTP_HISTORY
source: |+
  /**
  * Test HTTP Methods
  * 
  * Created with the help of an AI Agent and littlespidy.
  **/
  var req = requestResponse.request();
  
  logging().logToOutput("HTTP OPTIONS METHOD");
  
  logging().logToOutput(api().http().sendRequest(req.withMethod("OPTIONS")).response());
  
  logging().logToOutput("HTTP TRACE METHOD:");
  
  logging().logToOutput(api().http().sendRequest(req.withMethod("TRACE")).response());
  
  logging().logToOutput("HTTP PUT METHOD");
  
  logging().logToOutput(api().http().sendRequest(req.withMethod("PUT")).response());
  
  logging().logToOutput("HTTP CUSTOM METHOD");
  
  logging().logToOutput(api().http().sendRequest(req.withMethod("CUSTOM")).response());
  
