id: e81f4a9b-2c3d-4e5f-a6b7-8c9d0e1f2a3b
name: Filter POST Form Requests by Host
function: CUSTOM_ACTION
location: PROXY_HTTP_HISTORY
source: |+
  /**
   * Filter POST Form Requests by Host
   *
   * Custom Action that checks selected Proxy HTTP History items and highlights
   * POST requests with Form content-types (application/x-www-form-urlencoded or
   * multipart/form-data) matching the specified target host.
   *
   * Created with the help of an AI Agent and littlespidy.
   */

  // ── Configuration ─────────────────────────────────────────────
  String targetHost = "example.com";
  // ──────────────────────────────────────────────────────────────

  var request = requestResponse.request();
  String host = request.httpService().host().toLowerCase();

  // 1. Verify host match (case-insensitive partial match)
  if (!host.contains(targetHost.toLowerCase())) {
      logging().logToOutput("[SKIPPED] Host '" + host + "' does not match target host '" + targetHost + "'");
      return;
  }

  // 2. Verify HTTP method is POST
  if (!request.method().equalsIgnoreCase("POST")) {
      logging().logToOutput("[SKIPPED] " + host + " - Request method is " + request.method() + " (expected POST)");
      return;
  }

  // 3. Verify Content-Type is Form-encoded or Multipart
  String contentType = request.headerValue("Content-Type");
  if (contentType == null) {
      logging().logToOutput("[SKIPPED] " + host + " - Missing Content-Type header");
      return;
  }

  String ctLower = contentType.toLowerCase();
  boolean isForm = ctLower.contains("application/x-www-form-urlencoded") || ctLower.contains("multipart/form-data");

  if (!isForm) {
      logging().logToOutput("[SKIPPED] " + host + " - Content-Type '" + contentType + "' is not form-encoded");
      return;
  }

  // 4. Highlight & Annotate matching item
  requestResponse.annotations().setHighlightColor(HighlightColor.BLUE);
  requestResponse.annotations().setNotes("POST Form Request [" + host + "]");

  logging().logToOutput("[MATCHED] Highlighted POST Form Request for " + host + " (" + request.path() + ")");
