id: b7f3a291-4e12-48d9-a6c3-d9f2e1c58047
name: Detect HTTP Response Errors
function: VIEW_FILTER
location: PROXY_HTTP_HISTORY
source: |+
  /**
   * Created with the help of an AI Agent and littlespidy.
   *
   * Detects detailed error messages leaked in HTTP responses, covering:
   * - Web Servers   : Apache, NGINX, JBoss, Waitress, WebSEAL
   * - ASP.Net       : Stack traces, OLE DB, System exceptions
   * - Databases     : MySQL/MariaDB, PostgreSQL, Oracle, MSSQL, SQLite, IBM DB2,
   *                   Firebird, Ingres, HyperSQL, SAP MaxDB, Sybase, MongoDB, LDAP
   * - Languages     : PHP, Java, Python, Ruby, Perl, Groovy, Scala, Node.js/JavaScript, Go
   * - Frameworks    : Django, Hibernate, ActiveRecord, PDO
   *
   * Patterns sourced from the burp-suite-error-message-checks extension and extended
   * with additional coverage not present in the original match-rules.tab.
   *
   * Configuration:
   *   TARGET_HOST  - Set to a specific hostname (e.g. "example.com") to restrict
   *                  detection to that host, or use "*" to match all hosts.
   *   ANNOTATE     - Set to true to highlight matching responses in red and append
   *                  a note identifying the detected technology category.
   **/

  // ─── USER CONFIGURATION ────────────────────────────────────────────────────
  String  TARGET_HOST = "*";    // "*" = all hosts, or e.g. "example.com"
  boolean ANNOTATE    = true;   // true = red highlight + note appended
  // ───────────────────────────────────────────────────────────────────────────

  if (!requestResponse.hasResponse()) {
      return false;
  }

  // Host filter
  if (!TARGET_HOST.equals("*")) {
      String host = requestResponse.request().httpService().host();
      if (!host.equalsIgnoreCase(TARGET_HOST) && !host.toLowerCase().endsWith("." + TARGET_HOST.toLowerCase())) {
          return false;
      }
  }

  var response = requestResponse.response();
  String body  = response.bodyToString();

  if (body == null || body.isEmpty()) {
      return false;
  }

  // ─── DETECTION CHECKS ──────────────────────────────────────────────────────
  String detected = null;

  // ── Apache Server ──────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*AH[0-9]{5}:.*") ||
          body.matches("(?s).*mod_[\\w]+:.*")) {
          detected = "Apache Server error";
      }
  }

  // ── NGINX Server ───────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("client intended to address") ||
          body.contains("could not build optimal proxy_headers_hash")) {
          detected = "NGINX Server error";
      }
  }

  // ── JBoss ──────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*JBWEB[0-9]{6}:.*")) {
          detected = "JBoss error";
      }
  }

  // ── Waitress Python Server ─────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("(generated by waitress)")) {
          detected = "Waitress (Python server) error";
      }
  }

  // ── WebSEAL ────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*(132120c8|38ad52fa|38cf013d|38cf0259|38cf025a|38cf025b|38cf025c|38cf025d|38cf025e|38cf025f|38cf0421|38cf0424|38cf0425|38cf0427|38cf0428|38cf0432|38cf0434|38cf0437|38cf0439|38cf0442|38cf07aa|38cf08cc|38cf04d7|38cf04c6|websealerror).*")) {
          detected = "WebSEAL error";
      }
  }

  // ── ASP.Net ────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("Exception of type") ||
          body.contains("--- End of inner exception stack trace ---") ||
          body.contains("Microsoft OLE DB Provider") ||
          body.contains("\"Message\":\"Invalid web service call") ||
          body.contains("Syntax error in string in query expression") ||
          body.matches("(?s).*System\\.([A-Za-z]{1,32}\\.)*[A-Za-z]{0,32}Exception:.*") ||
          body.matches("(?s).*in [A-Za-z]:\\\\([A-Za-z0-9_]+\\\\)+[A-Za-z0-9_\\-]+(\\.aspx)?\\.cs:line [\\d]+.*") ||
          body.matches("(?s).*Error ([\\d-]+) \\([\\dA-Fa-f]+\\).*") ||
          body.matches("(?s).*([A-Za-z.]+)\\(([A-Za-z0-9, ]+)?\\) \\+[0-9]+.*") ||
          body.matches("(?s).*\\bat ([a-zA-Z0-9_]*\\.)*([a-zA-Z0-9_]+)\\([a-zA-Z0-9, \\[\\]&;]*\\).*")) {
          detected = "ASP.Net stack trace / exception";
      }
  }

  // ── MySQL / MariaDB ────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("You have an error in your SQL syntax; check the manual that corresponds to your MySQL server version for the right syntax to use near") ||
          body.matches("(?s).*Illegal mix of collations \\([\\w\\s,]+\\) and \\([\\w\\s,]+\\) for operation.*") ||
          body.contains("Error: Unknown column") ||
          body.matches("(?s).*Warning.*mysql_.*") ||
          body.contains("valid MySQL result") ||
          body.contains("MySqlClient.") ||
          body.contains("com.mysql.jdbc.exceptions") ||
          body.contains("warning mysql_") ||
          body.contains("1062 Duplicate entry") ||
          body.contains("DB Error:") ||
          body.contains("mysql_fetch") ||
          body.contains("mysql_num_rows") ||
          body.contains("mysql_query") ||
          body.contains("MySqlException") ||
          body.matches("(?s).*SQL syntax.*MySQL.*")) {
          detected = "MySQL/MariaDB error";
      }
  }

  // ── PostgreSQL ─────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("pg_query") ||
          body.contains("pg_exec") ||
          body.contains("PSQLException") ||
          body.matches("(?s).*PostgreSQL.*ERROR.*") ||
          body.matches("(?s).*Warning.*\\Wpg_.*") ||
          body.contains("valid PostgreSQL result") ||
          body.contains("Npgsql.") ||
          body.contains("org.postgresql.util.PSQLException") ||
          body.contains("unterminated quoted string at or near") ||
          body.matches("(?s).*ERROR:\\s+syntax error at or near.*")) {
          detected = "PostgreSQL error";
      }
  }

  // ── Oracle ─────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*\\bORA-[0-9]{5}.*") ||
          body.contains("Oracle error") ||
          body.matches("(?s).*Oracle.*Driver\\].*") ||
          body.contains("quoted string not properly terminated") ||
          body.matches("(?s).*Warning.*\\Woci_.*") ||
          body.matches("(?s).*Warning.*\\Wora_.*") ||
          body.contains("Warning: oci_parse()") ||
          body.contains("oracleException")) {
          detected = "Oracle DB error";
      }
  }

  // ── Microsoft SQL Server ───────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*\\[(ODBC SQL Server Driver|SQL Server|ODBC Driver Manager)\\].*") ||
          body.contains("Unclosed quotation mark") ||
          body.matches("(?s).*warning.*mssql_.*") ||
          body.matches("(?s).*Driver.* SQL[-_]*Server.*") ||
          body.matches("(?s).*SQL Server.*Driver.*") ||
          body.contains("Conversion failed when converting the") ||
          body.matches("(?s).*Cannot initialize the data source object of OLE DB provider.*for linked server.*") ||
          body.contains("Microsoft SQL Native Client") ||
          body.contains("ODBC SQL Server Driver") ||
          body.contains("SqlException") ||
          body.contains("SqlClient.") ||
          body.contains("mssql_query") ||
          body.matches("(?s).*Msg \\d+, Level \\d+, State \\d+.*") ||
          body.contains("Incorrect syntax near")) {
          detected = "Microsoft SQL Server error";
      }
  }

  // ── SQLite ─────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("SQLite/JDBCDriver") ||
          body.contains("SQLite.Exception") ||
          body.contains("System.Data.SQLite.SQLiteException") ||
          body.matches("(?s).*Warning.*sqlite_.*") ||
          body.matches("(?s).*Warning.*SQLite3::.*") ||
          body.contains("[SQLITE_ERROR]") ||
          body.contains("SQLite3::") ||
          body.contains("SQLITE_ERROR") ||
          body.contains("sqlite_query") ||
          body.contains("SQLiteException") ||
          body.matches("(?s).*near \".*\": syntax error.*")) {
          detected = "SQLite error";
      }
  }

  // ── IBM DB2 ────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*CLI Driver.*DB2.*") ||
          body.contains("DB2 SQL error") ||
          body.matches("(?s).*db2_\\w+\\(.*") ||
          body.matches("(?s).*DB2 SQL Error.*") ||
          body.matches("(?s).*SQLCODE=-\\d+.*") ||
          body.contains("com.ibm.db2")) {
          detected = "IBM DB2 error";
      }
  }

  // ── Firebird DB ────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("[function.ibase.query]") ||
          body.contains("Dynamic SQL Error") ||
          body.matches("(?s).*Warning.*ibase_.*")) {
          detected = "Firebird DB error";
      }
  }

  // ── Ingres DB ──────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*Warning.*ingre_.*") ||
          body.contains("Ingres SQLSTATE") ||
          body.matches("(?s).*Ingres\\W.*Driver.*") ||
          body.contains("HSQLDB")) {
          detected = "Ingres DB error";
      }
  }

  // ── HyperSQL ───────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("org.hsqldb.jdbc")) {
          detected = "HyperSQL error";
      }
  }

  // ── SAP MaxDB ──────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*SQL error.*POS([0-9]+).*") ||
          body.matches("(?s).*Warning.*maxdb.*")) {
          detected = "SAP MaxDB error";
      }
  }

  // ── Sybase ─────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?si).*Warning.*sybase.*") ||
          body.contains("Sybase message") ||
          body.matches("(?s).*Sybase.*Server message.*")) {
          detected = "Sybase error";
      }
  }

  // ── MongoDB ────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*E QUERY\\s+\\[thread1\\] SyntaxError:.*") ||
          body.contains("uncaught exception:")) {
          detected = "MongoDB error";
      }
  }

  // ── LDAP Injection Trace ───────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*((dn|dc|cn|ou|uid|o|c)=[\\w\\d]*,\\s?){2,}.*")) {
          detected = "LDAP DN leakage in response";
      }
  }

  // ── Generic JDBC / ODBC / OLE DB ──────────────────────────────────────────
  if (detected == null) {
      if (body.contains("ODBC Driver") ||
          body.contains("JDBCException") ||
          body.contains("java.sql.SQLException") ||
          body.contains("Data source rejected") ||
          body.contains("SQLSTATE[") ||
          body.contains("SQL command not properly ended") ||
          body.contains("invalid input syntax for") ||
          body.contains("division by zero")) {
          detected = "JDBC/ODBC/OLE DB error";
      }
  }

  // ── PHP PDO ────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("PDOException") ||
          body.matches("(?s).*PDO::.*SQLSTATE.*")) {
          detected = "PHP PDO error";
      }
  }

  // ── Hibernate / JPA ────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("HibernateException") ||
          body.contains("QuerySyntaxException") ||
          body.contains("org.hibernate")) {
          detected = "Hibernate/JPA error";
      }
  }

  // ── Django ORM ─────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("django.db.utils.") ||
          body.contains("ProgrammingError at")) {
          detected = "Django ORM error";
      }
  }

  // ── Ruby / ActiveRecord ────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*\\.rb:[0-9]+:in.*") ||
          body.contains("ActiveRecord::StatementInvalid") ||
          body.contains("ActiveRecord::RecordNotFound") ||
          body.matches("(?s).*from /[^ ]+\\.rb:\\d+:in `.*'.*") ||
          body.contains("(backtrace)")) {
          detected = "Ruby/ActiveRecord error";
      }
  }

  // ── PHP ────────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*\\.php on line [0-9]+.*") ||
          body.matches("(?s).*\\.php</b> on line <b>[0-9]+.*") ||
          body.contains("Fatal error:") ||
          body.matches("(?s).*\\.php:[0-9]+.*") ||
          body.matches("(?s).*Undefined (index|variable|offset):.*") ||
          body.matches("(?s).*Fatal error:.*in /.*\\.php.*line \\d+.*") ||
          body.matches("(?s).*Warning:.*in /.*\\.php.*line \\d+.*") ||
          body.matches("(?s).*Parse error:.*in /.*\\.php.*line \\d+.*") ||
          body.matches("(?s).*in /[^ ]+\\.php on line \\d+.*")) {
          detected = "PHP error / stack trace";
      }
  }

  // ── Java ───────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*\\.java:[0-9]+.*") ||
          body.matches("(?s).*\\.java\\((Inlined )?Compiled Code\\).*") ||
          body.contains(".invoke(Unknown Source)") ||
          body.contains("nested exception is") ||
          body.matches("(?s).*java\\.lang\\.([A-Za-z0-9_]*)Exception.*") ||
          body.contains("java.io.FileNotFoundException:") ||
          body.contains("Exception in thread") ||
          body.matches("(?s).*\\bat [a-zA-Z][a-zA-Z0-9_.]*\\.[a-zA-Z][a-zA-Z0-9_]*\\([^)]*\\.java:\\d+\\).*") ||
          body.matches("(?s).*(Exception|Error):\\s+.*\\n.*at .*")) {
          detected = "Java stack trace / exception";
      }
  }

  // ── Python ─────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.contains("Traceback (most recent call last):") ||
          body.matches("(?s).*File \"[A-Za-z0-9\\-_./]*\", line [0-9]+, in.*") ||
          body.contains("NameError:") ||
          body.contains("ImportError:") ||
          body.contains("IndentationError:")) {
          detected = "Python traceback / error";
      }
  }

  // ── Perl ───────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*at (\\/[A-Za-z0-9.]+)*\\.pm line [0-9]+.*")) {
          detected = "Perl error";
      }
  }

  // ── Groovy ─────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*\\.groovy:[0-9]+.*")) {
          detected = "Groovy stack trace";
      }
  }

  // ── Scala ──────────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*\\.scala:[0-9]+.*")) {
          detected = "Scala stack trace";
      }
  }

  // ── Node.js / JavaScript ───────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*\\.js:[0-9]+:[0-9]+.*") ||
          body.contains("ReferenceError:") ||
          body.contains("TypeError:") ||
          body.contains("UnhandledPromiseRejectionWarning:") ||
          body.matches("(?s).*Error:.*\\n.*at .* \\([^)]*:\\d+:\\d+\\).*") ||
          (body.contains("Error:") && body.matches("(?s).*at .*\\.js:\\d+:\\d+.*"))) {
          detected = "Node.js / JavaScript error";
      }
  }

  // ── Go panic ───────────────────────────────────────────────────────────────
  if (detected == null) {
      if (body.matches("(?s).*panic:.*\\n.*goroutine \\d+.*") ||
          body.matches("(?s).*goroutine \\d+ \\[.*\\]:.*") ||
          (body.contains("panic:") && body.matches("(?s).*/.*\\.go:\\d+.*"))) {
          detected = "Go panic / stack trace";
      }
  }

  // ─── RESULT ────────────────────────────────────────────────────────────────
  if (detected != null) {
      if (ANNOTATE) {
          requestResponse.annotations().setHighlightColor(HighlightColor.RED);
          String existingNote = requestResponse.annotations().notes();
          String newNote      = "[Error Detected] " + detected;
          if (existingNote == null || existingNote.isEmpty()) {
              requestResponse.annotations().setNotes(newNote);
          } else if (!existingNote.contains(newNote)) {
              requestResponse.annotations().setNotes(existingNote + " | " + newNote);
          }
      }
      return true;
  }

  return false;

